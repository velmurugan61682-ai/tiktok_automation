# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Credentials
SUPER_ADMIN_EMAIL="admin@company.com"
SUPER_ADMIN_PASSWORD="admin_bcrypt_password_here_or_plain_for_testing"
SUPER_ADMIN_NAME="System Administrator"

# Authentication
JWT_SECRET="super-secret-jwt-key-for-tenant-saas"

# Integrations (Optional / Configurable)
TIKTOK_CLIENT_ID="your_tiktok_client_id"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
TIKTOK_SCOPE="user.info.basic,user.info.profile,user.info.stats,video.list"
CLOUDINARY_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# MongoDB connection URL
MONGODB_URI="mongodb://localhost:27017/creatorflow_ai"

# Razorpay Subscription Credentials
# Create a recurring plan in Razorpay Dashboard and paste the plan id here.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_PLAN_ID="plan_your_monthly_pro_plan_id"
RAZORPAY_PRO_PRICE="499"
RAZORPAY_SUBSCRIPTION_CYCLES="12"